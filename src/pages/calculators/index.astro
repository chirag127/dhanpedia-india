---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { url } from '../../utils/paths';

const plannedCalculators = [
  {
    category: "Compounding & Wealth Accumulation",
    items: [
      { name: "Systematic Investment Plan (SIP) Calculator", desc: "Calculates future value with monthly compounding and real inflation-adjusted terminal corpus." },
      { name: "Step-Up SIP Calculator", desc: "Models annual percentage or fixed rupee contribution escalations matching salary growth." },
      { name: "Systematic Withdrawal Plan (SWP) Depletion Calculator", desc: "Simulates post-retirement monthly cashflows and capital exhaustion timelines." },
      { name: "Lumpsum Compounding Calculator", desc: "Models multi-decade compound interest with custom compounding frequencies." }
    ]
  },
  {
    category: "Lending, Mortgages & Amortization",
    items: [
      { name: "Home Loan EMI & Reducing Balance Amortization", desc: "Closed-form daily reducing balance amortization schedule with monthly principal/interest split." },
      { name: "Loan Prepayment Optimizer", desc: "Calculates interest savings and tenure reduction through recurring or lump-sum prepayments." },
      { name: "Prepayment vs. SIP Investment Comparator", desc: "Mathematical decision matrix evaluating whether to prepay a mortgage or invest in equities." }
    ]
  },
  {
    category: "Direct Taxation & Compliance",
    items: [
      { name: "Section 115BAC New vs. Old Tax Regime Comparator", desc: "Calculates exact break-even deductions (HRA, 80C, 80D, 24b) for salaried and consulting income." },
      { name: "Capital Gains Tax Estimator (Post-Budget 2024)", desc: "Models 20% STCG and 12.5% LTCG across listed equity, debt, real estate, and gold." },
      { name: "Advance Tax & Section 234A/B/C Penalty Estimator", desc: "Calculates quarterly liability deadlines and statutory deferment interest." }
    ]
  },
  {
    category: "Retirement & Financial Independence",
    items: [
      { name: "Indian FIRE Corpus Sizer", desc: "Determines Lean, Standard, and Fat FIRE corpus targets based on non-discretionary monthly burn rate." },
      { name: "Safe Withdrawal Rate (SWR) Stress Simulator", desc: "Simulates 30-40 year retirement survival rates across Indian inflation regimes." },
      { name: "NPS Tier 1 Annuity & Lump-Sum Calculator", desc: "Models 60% tax-free lump sum and mandatory 40% annuity yield." }
    ]
  }
];
---

<BaseLayout
  title="Financial Calculator Suite — Auditable Decision Tools | Dhanpedia India"
  description="Deterministic, client-side personal finance calculators with closed-form mathematical equations and transparent code. Zero black-box estimates."
>
  <div class="site-container page-container">
    <div class="page-header">
      <nav class="breadcrumbs" aria-label="Breadcrumb">
        <a href={url('/')}>Home</a>
        <span class="sep">/</span>
        <span class="current">Calculators</span>
      </nav>
      <h1 class="page-title">Deterministic Financial Calculators</h1>
      <p class="page-lead">
        Dhanpedia India is engineering 40 open, auditable financial calculators. Every tool uses closed-form mathematical formulas, explains the underlying equations in natural spoken English, and runs entirely in your browser with zero data transmission.
      </p>
    </div>

    <!-- Live Interactive Demonstration Calculator: SIP Future Value -->
    <div class="calculator-card live-demo-card">
      <div class="calc-header">
        <span class="badge badge-emerald">Interactive Engine Demo</span>
        <h2 class="calc-title">Systematic Investment Plan (SIP) Calculator</h2>
        <p class="calc-desc">
          Calculates the expected future wealth generated by monthly systematic investments, articulated in spoken mathematical prose.
        </p>
      </div>

      <div class="calc-form-grid">
        <div class="calc-field">
          <label for="sip-monthly">Monthly Investment (₹):</label>
          <input type="number" id="sip-monthly" value="25000" min="500" step="500" />
        </div>
        <div class="calc-field">
          <label for="sip-rate">Expected Annual Return (%):</label>
          <input type="number" id="sip-rate" value="12" min="1" max="30" step="0.5" />
        </div>
        <div class="calc-field">
          <label for="sip-tenure">Investment Duration (Years):</label>
          <input type="number" id="sip-tenure" value="20" min="1" max="50" step="1" />
        </div>
      </div>

      <div class="calc-results-panel" id="sip-results">
        <div class="result-row">
          <span class="res-label">Total Principal Invested:</span>
          <span class="res-val" id="res-invested">₹60,00,000</span>
        </div>
        <div class="result-row">
          <span class="res-label">Estimated Wealth Gain:</span>
          <span class="res-val highlight" id="res-gain">₹1,89,78,655</span>
        </div>
        <div class="result-row total">
          <span class="res-label">Expected Total Value:</span>
          <span class="res-val large" id="res-total">₹2,49,78,655</span>
        </div>

        <div class="spoken-math-box">
          <h4>Spoken Mathematical Explanation:</h4>
          <p id="spoken-explanation">
            Investing twenty-five thousand rupees each month at an annualized rate of twelve percent for twenty years results in a total principal contribution of sixty lakh rupees. The compounding returns generate an additional wealth gain of one crore eighty-nine lakh seventy-eight thousand and six hundred and fifty-five rupees, resulting in a final accumulated corpus of two crore forty-nine lakh seventy-eight thousand and six hundred and fifty-five rupees.
          </p>
        </div>
      </div>
    </div>

    <!-- Planned 40-Calculator Directory -->
    <div class="calculator-directory-section">
      <h2 class="section-heading">Roadmap: 40 Auditable Financial Decision Engines</h2>
      <div class="directory-grid">
        {plannedCalculators.map(group => (
          <div class="directory-group-card">
            <h3 class="group-title">{group.category}</h3>
            <ul class="calc-items-list">
              {group.items.map(item => (
                <li class="calc-item">
                  <strong>{item.name}</strong>
                  <p>{item.desc}</p>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </div>
</BaseLayout>

<script>
  function formatINR(val: number) {
    return '₹' + Math.round(val).toLocaleString('en-IN');
  }

  function numberToWordsINR(num: number): string {
    // Basic approximate conversion for spoken audio
    if (num >= 10000000) {
      const cr = (num / 10000000).toFixed(2);
      return `${cr} crore rupees`;
    } else if (num >= 100000) {
      const lk = (num / 100000).toFixed(2);
      return `${lk} lakh rupees`;
    }
    return `${Math.round(num).toLocaleString('en-IN')} rupees`;
  }

  function calculateSIP() {
    const P = parseFloat((document.getElementById('sip-monthly') as HTMLInputElement).value) || 0;
    const annualR = parseFloat((document.getElementById('sip-rate') as HTMLInputElement).value) || 0;
    const years = parseFloat((document.getElementById('sip-tenure') as HTMLInputElement).value) || 0;

    const n = years * 12;
    const r = (annualR / 100) / 12;

    const invested = P * n;
    let total = 0;
    if (r > 0) {
      total = P * (((Math.pow(1 + r, n) - 1) / r) * (1 + r));
    } else {
      total = invested;
    }
    const gain = total - invested;

    const elInvested = document.getElementById('res-invested');
    const elGain = document.getElementById('res-gain');
    const elTotal = document.getElementById('res-total');
    const elSpoken = document.getElementById('spoken-explanation');

    if (elInvested) elInvested.textContent = formatINR(invested);
    if (elGain) elGain.textContent = formatINR(gain);
    if (elTotal) elTotal.textContent = formatINR(total);

    if (elSpoken) {
      elSpoken.textContent = `Investing ${numberToWordsINR(P)} each month at an annualized rate of ${annualR} percent for ${years} years results in a total principal contribution of ${numberToWordsINR(invested)}. The compounding returns generate an additional wealth gain of ${numberToWordsINR(gain)}, producing an expected terminal corpus of ${numberToWordsINR(total)}.`;
    }
  }

  ['sip-monthly', 'sip-rate', 'sip-tenure'].forEach(id => {
    document.getElementById(id)?.addEventListener('input', calculateSIP);
  });
</script>

<style>
  .page-container {
    padding: var(--space-8) var(--space-4) var(--space-16) var(--space-4);
    max-width: 960px;
  }

  .page-header {
    margin-bottom: var(--space-10);
  }

  .breadcrumbs {
    font-size: 0.85rem;
    margin-bottom: var(--space-3);
  }

  .breadcrumbs a {
    color: var(--text-muted);
    text-decoration: none;
  }

  .breadcrumbs .sep {
    margin: 0 var(--space-2);
    color: var(--border-medium);
  }

  .breadcrumbs .current {
    color: var(--text-primary);
    font-weight: 600;
  }

  .page-title {
    font-size: clamp(2.2rem, 4vw, 3rem);
    margin-bottom: var(--space-3);
  }

  .page-lead {
    font-size: 1.15rem;
    color: var(--text-secondary);
    line-height: 1.7;
  }

  .live-demo-card {
    background-color: var(--bg-surface);
    border: 2px solid var(--accent-gold);
    border-radius: var(--radius-lg);
    padding: var(--space-8);
    box-shadow: var(--shadow-md);
    margin-bottom: var(--space-12);
  }

  .calc-title {
    font-size: 1.6rem;
    margin-top: var(--space-2);
    margin-bottom: var(--space-2);
    border: none;
    padding: 0;
  }

  .calc-desc {
    font-size: 0.95rem;
    color: var(--text-secondary);
    margin-bottom: var(--space-6);
  }

  .calc-form-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-4);
    margin-bottom: var(--space-6);
  }

  @media (min-width: 640px) {
    .calc-form-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .calc-field label {
    display: block;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--text-primary);
    margin-bottom: var(--space-1);
  }

  .calc-field input {
    width: 100%;
    padding: var(--space-3);
    font-size: 1.1rem;
    border-radius: var(--radius-md);
    border: 1px solid var(--border-medium);
    background-color: var(--bg-surface-elevated);
    color: var(--text-primary);
  }

  .calc-results-panel {
    background-color: var(--bg-surface-elevated);
    border-radius: var(--radius-md);
    padding: var(--space-6);
    border: 1px solid var(--border-light);
  }

  .result-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: var(--space-2) 0;
    border-bottom: 1px solid var(--border-light);
  }

  .result-row.total {
    border-bottom: none;
    padding-top: var(--space-3);
  }

  .res-label {
    font-size: 0.95rem;
    color: var(--text-secondary);
  }

  .res-val {
    font-family: var(--font-mono);
    font-size: 1.1rem;
    font-weight: 700;
    color: var(--text-primary);
  }

  .res-val.highlight {
    color: var(--accent-emerald);
  }

  .res-val.large {
    font-size: 1.4rem;
    color: var(--accent-gold-dark);
  }

  [data-theme="dark"] .res-val.large {
    color: var(--accent-gold);
  }

  .spoken-math-box {
    margin-top: var(--space-5);
    padding-top: var(--space-4);
    border-top: 1px solid var(--border-light);
  }

  .spoken-math-box h4 {
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--text-muted);
    margin-bottom: var(--space-1);
  }

  .spoken-math-box p {
    font-size: 0.95rem;
    color: var(--text-secondary);
    line-height: 1.6;
    margin: 0;
  }

  .section-heading {
    font-size: 1.6rem;
    margin-bottom: var(--space-6);
  }

  .directory-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-6);
  }

  @media (min-width: 640px) {
    .directory-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .directory-group-card {
    background-color: var(--bg-surface);
    border: 1px solid var(--border-light);
    border-radius: var(--radius-md);
    padding: var(--space-6);
  }

  .group-title {
    font-size: 1.2rem;
    margin-bottom: var(--space-4);
    border-bottom: 1px solid var(--border-light);
    padding-bottom: var(--space-2);
  }

  .calc-items-list {
    list-style: none;
    margin: 0;
  }

  .calc-item {
    margin-bottom: var(--space-4);
  }

  .calc-item strong {
    font-size: 0.95rem;
    color: var(--text-primary);
    display: block;
    margin-bottom: 2px;
  }

  .calc-item p {
    font-size: 0.85rem;
    color: var(--text-secondary);
    margin: 0;
    line-height: 1.4;
  }
</style>
