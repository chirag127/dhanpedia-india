---
import BaseLayout from '../layouts/BaseLayout.astro';
import { url } from '../utils/paths';
---

<BaseLayout
  title="About the Author — Chirag Singhal | Dhanpedia India"
  description="Biographical background, public professional profiles, and editorial philosophy of Chirag Singhal, curator of Dhanpedia India."
>
  <div class="site-container page-container">
    <div class="page-header">
      <nav class="breadcrumbs" aria-label="Breadcrumb">
        <a href={url('/')}>Home</a>
        <span class="sep">/</span>
        <span class="current">Author</span>
      </nav>
      <h1 class="page-title">Chirag Singhal</h1>
      <p class="page-lead">
        Curator, Author, and Technical Lead for Dhanpedia India.
      </p>
    </div>

    <div class="author-layout">
      <div class="author-main">
        <h2>Editorial & Technical Philosophy</h2>
        <p>
          Chirag Singhal is a software engineer, investor, and financial researcher dedicated to building durable, mathematically rigorous, open-source knowledge systems.
        </p>
        <p>
          Dhanpedia India represents an effort to synthesize the labyrinth of Indian direct taxation, banking regulations, statutory dispute redressal mechanisms, and capital markets frameworks into a permanent, freely accessible, evidence-grounded encyclopedia. The writing reflects an uncompromising commitment to primary statutory evidence: every threshold, circular, and computational model is checked against primary gazette notifications and regulatory releases rather than second-hand commentary.
        </p>
        <p>
          The platform is engineered specifically for Indian investors, salaried professionals, software engineers, entrepreneurs, and advanced investors who demand technical precision over superficial marketing.
        </p>

        <h2>Public Professional Profiles</h2>
        <div class="profiles-grid">
          <a href="https://github.com/chirag127/" target="_blank" rel="noopener noreferrer" class="profile-card">
            <span class="p-platform">GitHub</span>
            <span class="p-handle">@chirag127</span>
          </a>
          <a href="https://www.linkedin.com/in/chirag127/" target="_blank" rel="noopener noreferrer" class="profile-card">
            <span class="p-platform">LinkedIn</span>
            <span class="p-handle">Chirag Singhal</span>
          </a>
          <a href="https://x.com/singhal127" target="_blank" rel="noopener noreferrer" class="profile-card">
            <span class="p-platform">X (Twitter)</span>
            <span class="p-handle">@singhal127</span>
          </a>
          <a href="https://www.youtube.com/@ChiragSinghal127" target="_blank" rel="noopener noreferrer" class="profile-card">
            <span class="p-platform">YouTube</span>
            <span class="p-handle">@ChiragSinghal127</span>
          </a>
          <a href="https://www.reddit.com/user/Far_Macaron_9910/" target="_blank" rel="noopener noreferrer" class="profile-card">
            <span class="p-platform">Reddit</span>
            <span class="p-handle">u/Far_Macaron_9910</span>
          </a>
          <a href="https://buymeacoffee.com/chirag127" target="_blank" rel="noopener noreferrer" class="profile-card">
            <span class="p-platform">Support Project</span>
            <span class="p-handle">Buy Me a Coffee</span>
          </a>
        </div>

        <h2>Contact Information</h2>
        <p>
          For editorial review, correction submissions, or technical inquiries regarding the Dhanpedia India architecture, contact Chirag Singhal directly at:
        </p>
        <p>
          <strong>Official Editorial Email:</strong> <a href="mailto:chirag@oriz.in">chirag@oriz.in</a>
        </p>
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  .page-container {
    padding: var(--space-8) var(--space-4) var(--space-16) var(--space-4);
    max-width: 820px;
  }

  .page-header {
    margin-bottom: var(--space-8);
  }

  .breadcrumbs {
    font-size: 0.85rem;
    margin-bottom: var(--space-3);
  }

  .breadcrumbs a {
    color: var(--text-muted);
    text-decoration: none;
  }

  .breadcrumbs .sep {
    margin: 0 var(--space-2);
    color: var(--border-medium);
  }

  .breadcrumbs .current {
    color: var(--text-primary);
    font-weight: 600;
  }

  .page-title {
    font-size: clamp(2.2rem, 4vw, 3rem);
    margin-bottom: var(--space-2);
  }

  .page-lead {
    font-size: 1.15rem;
    color: var(--text-secondary);
  }

  .author-main h2 {
    font-size: 1.5rem;
    margin-top: var(--space-8);
    margin-bottom: var(--space-3);
  }

  .author-main p {
    font-size: 1.05rem;
    line-height: 1.8;
    color: var(--text-primary);
    margin-bottom: var(--space-4);
  }

  .profiles-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-3);
    margin: var(--space-6) 0;
  }

  @media (min-width: 640px) {
    .profiles-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .profile-card {
    display: flex;
    flex-direction: column;
    padding: var(--space-4);
    background-color: var(--bg-surface);
    border: 1px solid var(--border-light);
    border-radius: var(--radius-md);
    text-decoration: none;
    transition: all var(--transition-fast);
  }

  .profile-card:hover {
    border-color: var(--accent-gold);
    transform: translateY(-2px);
  }

  .p-platform {
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--text-muted);
    margin-bottom: 2px;
  }

  .p-handle {
    font-size: 1rem;
    font-weight: 600;
    color: var(--text-primary);
  }
</style>
