---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { url } from '../../utils/paths';
import articleRegistry from '../../../data/articles/article-registry.json';

const articles = articleRegistry.articles;
---

<BaseLayout
  title="Books & Offline Downloads — Multi-Format Library | Dhanpedia India"
  description="Download offline reading editions of Dhanpedia India: clean Markdown files, plain text, and planned master EPUB and PDF publication volumes."
>
  <div class="site-container page-container">
    <div class="page-header">
      <nav class="breadcrumbs" aria-label="Breadcrumb">
        <a href={url('/')}>Home</a>
        <span class="sep">/</span>
        <span class="current">Downloads</span>
      </nav>
      <h1 class="page-title">Books & Offline Downloads</h1>
      <p class="page-lead">
        Dhanpedia India is engineered as a single-source-of-truth publication. The same canonical content that powers our web pages generates clean Markdown reading files, audio-friendly text files, and future master multi-volume EPUB and PDF editions.
      </p>
    </div>

    <!-- Active Master Publication Box -->
    <div class="master-publication-banner" style="background: linear-gradient(135deg, rgba(0, 82, 204, 0.08) 0%, rgba(16, 185, 129, 0.08) 100%); border: 2px solid var(--color-primary); padding: 2rem; border-radius: 12px; margin-bottom: 2.5rem;">
      <div class="banner-badge">
        <span class="badge badge-emerald" style="background: var(--color-primary); color: #ffffff; padding: 0.35rem 0.75rem; border-radius: 20px; font-weight: 600; font-size: 0.85rem;">Active Master Edition Available</span>
      </div>
      <h2 class="banner-title" style="font-size: 1.8rem; margin: 0.8rem 0 0.5rem; color: var(--color-text-heading);">Dhanpedia India: The Master Encyclopedia (Audio-Native Edition)</h2>
      <p class="banner-desc" style="font-size: 1.05rem; line-height: 1.6; color: var(--color-text-body); max-width: 850px; margin-bottom: 1.25rem;">
        Compiled directly from our canonical research models, covering the 26 Master Domains, all 52 Foundational Concepts, 14 Spoken Mathematical Formulas, 12 Structured Learning Curricula, the complete 11,000-word DICGC Deposit Insurance Treatise, 32 Statutory Authorities, and Forensic Shadow Economy legal limits.
      </p>
      
      <div class="banner-features" style="display: flex; flex-wrap: wrap; gap: 1rem; margin-bottom: 1.5rem; font-size: 0.9rem; color: var(--color-text-muted);">
        <span>✦ <strong>Moon+ Reader Pro TTS Ready</strong></span>
        <span>✦ <strong>Zero Raw Formulas (Spoken English Math)</strong></span>
        <span>✦ <strong>EPUB 3 with Hierarchical NCX Table of Contents</strong></span>
        <span>✦ <strong>100% Free & Open Access</strong></span>
      </div>

      <div class="banner-actions" style="display: flex; flex-wrap: wrap; gap: 1rem;">
        <a href={url('/books/dhanpedia-india-master-edition.epub')} download="dhanpedia-india-master-edition.epub" class="btn btn-primary" style="padding: 0.75rem 1.5rem; font-weight: 600; text-decoration: none; border-radius: 6px; display: inline-flex; align-items: center; gap: 0.5rem; background: var(--color-primary); color: #fff;">
          📥 Download Master EPUB (for Moon+ Reader Pro)
        </a>
        <a href={url('/books/dhanpedia-india-master-edition.md')} download="dhanpedia-india-master-edition.md" class="btn btn-outline" style="padding: 0.75rem 1.5rem; font-weight: 600; text-decoration: none; border-radius: 6px; border: 1px solid var(--color-primary); color: var(--color-primary); display: inline-flex; align-items: center; gap: 0.5rem;">
          📄 Download Master Markdown (.md)
        </a>
      </div>

      <div class="tts-guide-box" style="margin-top: 1.5rem; padding: 1rem 1.25rem; background: rgba(0,0,0,0.03); border-radius: 8px; font-size: 0.9rem; line-height: 1.55; color: var(--color-text-muted);">
        <strong>🎧 Moon+ Reader Pro Text-to-Speech (TTS) Listening Tips:</strong>
        Download the EPUB file to your Android phone, open it in <em>Moon+ Reader Pro</em>, tap the screen center, select the <strong>Speaker (TTS)</strong> icon. Enable background playback so listening continues with the screen turned off. Pair with Google Speech Services Neural Voice (English India or English Natural) for human-like audio cadence.
      </div>
    </div>

    <!-- Active Article Downloads -->
    <section class="downloads-section">
      <h2 class="section-title">Available Substantive Treatises for Offline Reading</h2>
      <div class="download-cards-grid">
        {articles.map(art => (
          <div class="dl-card">
            <div class="dl-card-badge">
              <span class="badge badge-emerald">{art.categoryName}</span>
              <span class="dl-words">{art.wordCount.toLocaleString()} words</span>
            </div>
            <h3 class="dl-card-title">{art.title}</h3>
            <p class="dl-card-desc">{art.summary}</p>
            
            <div class="dl-actions-row">
              <a href={url(`/articles/${art.slug}`)} class="btn btn-outline btn-sm">
                Read Online
              </a>
              <a href={`https://raw.githubusercontent.com/chirag127/dhanpedia-india/main/src/content/articles/${art.slug}.md`} target="_blank" rel="noopener noreferrer" class="btn btn-primary btn-sm">
                Download Markdown (.md)
              </a>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- Architecture Note on Decoupled Distribution -->
    <div class="distribution-note-box callout callout-info">
      <div class="callout-title">Architecture Notice: Zero-Cost Large File Distribution</div>
      <p>
        To respect GitHub Pages repository size limits and ensure ultra-fast web deployments, master EPUB and PDF compendiums exceeding several hundred megabytes are published as detached release assets via GitHub Releases. The core website shell remains lightweight, fast, and free of hosting costs.
      </p>
    </div>
  </div>
</BaseLayout>

<style>
  .page-container {
    padding: var(--space-8) var(--space-4) var(--space-16) var(--space-4);
    max-width: 900px;
  }

  .page-header {
    margin-bottom: var(--space-8);
  }

  .breadcrumbs {
    font-size: 0.85rem;
    margin-bottom: var(--space-3);
  }

  .breadcrumbs a {
    color: var(--text-muted);
    text-decoration: none;
  }

  .breadcrumbs .sep {
    margin: 0 var(--space-2);
    color: var(--border-medium);
  }

  .breadcrumbs .current {
    color: var(--text-primary);
    font-weight: 600;
  }

  .page-title {
    font-size: clamp(2.2rem, 4vw, 3rem);
    margin-bottom: var(--space-3);
  }

  .page-lead {
    font-size: 1.15rem;
    color: var(--text-secondary);
    line-height: 1.7;
  }

  .master-publication-banner {
    background-color: var(--bg-surface);
    border: 2px solid var(--accent-gold);
    border-radius: var(--radius-lg);
    padding: var(--space-8);
    margin-bottom: var(--space-12);
    box-shadow: var(--shadow-md);
  }

  .banner-title {
    font-size: 1.6rem;
    margin-top: var(--space-2);
    margin-bottom: var(--space-2);
    border: none;
    padding: 0;
  }

  .banner-desc {
    font-size: 1.05rem;
    color: var(--text-secondary);
    line-height: 1.6;
    margin-bottom: var(--space-4);
  }

  .banner-features {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--accent-gold-dark);
  }

  [data-theme="dark"] .banner-features {
    color: var(--accent-gold);
  }

  .downloads-section {
    margin-bottom: var(--space-12);
  }

  .section-title {
    font-size: 1.6rem;
    margin-bottom: var(--space-6);
  }

  .download-cards-grid {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }

  .dl-card {
    background-color: var(--bg-surface);
    border: 1px solid var(--border-light);
    border-left: 5px solid var(--accent-emerald);
    border-radius: var(--radius-md);
    padding: var(--space-6);
  }

  .dl-card-badge {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    margin-bottom: var(--space-2);
  }

  .dl-words {
    font-size: 0.8rem;
    color: var(--text-muted);
  }

  .dl-card-title {
    font-size: 1.35rem;
    margin-bottom: var(--space-2);
  }

  .dl-card-desc {
    font-size: 0.95rem;
    color: var(--text-secondary);
    line-height: 1.6;
    margin-bottom: var(--space-4);
  }

  .dl-actions-row {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    padding-top: var(--space-3);
    border-top: 1px solid var(--border-light);
  }

  .btn-sm {
    padding: var(--space-2) var(--space-4);
    font-size: 0.85rem;
  }
</style>
