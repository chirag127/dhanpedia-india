---
import { getCollection, render } from 'astro:content';
import ArticleLayout from '../../layouts/ArticleLayout.astro';

export async function getStaticPaths() {
  const articles = await getCollection('articles');
  return articles.map(entry => ({
    params: { slug: entry.data.slug || entry.id },
    props: { entry }
  }));
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);

// Format headings for TableOfContents
const tocHeadings = headings
  .filter(h => h.depth === 2 || h.depth === 3)
  .map(h => ({
    id: h.slug,
    text: h.text,
    level: h.depth
  }));
---

<ArticleLayout
  title={entry.data.title}
  summary={entry.data.summary}
  categoryId={entry.data.categoryId}
  categoryName={entry.data.categoryName}
  lastVerifiedDate={entry.data.lastVerifiedDate}
  readingTimeMinutes={entry.data.readingTimeMinutes}
  wordCount={entry.data.wordCount}
  sourceIds={entry.data.sourceIds}
  headings={tocHeadings}
>
  <Content />
</ArticleLayout>
