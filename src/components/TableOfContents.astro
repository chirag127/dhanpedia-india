---
interface HeadingItem {
  id: string;
  text: string;
  level: number;
}

interface Props {
  headings?: HeadingItem[];
}

const { headings = [] } = Astro.props;
---

<aside id="right-toc" class="sidebar-right" aria-label="Table of Contents">
  <div class="toc-header">
    <span class="toc-title">On This Page</span>
    <button id="toc-toggle" class="toc-toggle-btn" aria-label="Collapse table of contents" title="Collapse table of contents">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M9 18l6-6-6-6"/>
      </svg>
    </button>
  </div>

  <div class="reading-progress-bar-container">
    <div id="reading-progress-bar" class="reading-progress-bar"></div>
  </div>

  <nav class="toc-nav">
    {headings.length > 0 ? (
      <ul class="toc-list" id="toc-list">
        {headings.map(h => (
          <li class={`toc-item level-${h.level}`}>
            <a href={`#${h.id}`} class="toc-link" data-id={h.id}>
              {h.text}
            </a>
          </li>
        ))}
      </ul>
    ) : (
      <p class="toc-empty">Headings will index dynamically.</p>
    )}
  </nav>

  <div class="toc-footer">
    <a href="#top" class="back-to-top-link">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M12 19V5M5 12l7-7 7 7"/>
      </svg>
      Back to top
    </a>
  </div>
</aside>

<script>
  // Scroll-spy and reading progress logic
  const headings = Array.from(document.querySelectorAll('article h2, article h3'));
  const tocLinks = document.querySelectorAll('.toc-link');
  const progressBar = document.getElementById('reading-progress-bar');

  function updateTocSpy() {
    // Reading progress calculation
    const article = document.querySelector('article');
    if (article && progressBar) {
      const rect = article.getBoundingClientRect();
      const totalHeight = rect.height - window.innerHeight;
      const progress = Math.min(100, Math.max(0, (-rect.top / totalHeight) * 100));
      progressBar.style.width = `${progress}%`;
    }

    // Current heading spy
    let currentId = '';
    const scrollPos = window.scrollY + 120;

    for (let i = 0; i < headings.length; i++) {
      const heading = headings[i] as HTMLElement;
      if (heading.offsetTop <= scrollPos) {
        currentId = heading.id;
      }
    }

    tocLinks.forEach(link => {
      const href = link.getAttribute('data-id');
      if (href === currentId) {
        link.classList.add('active');
      } else {
        link.classList.remove('active');
      }
    });
  }

  window.addEventListener('scroll', updateTocSpy, { passive: true });
  updateTocSpy();

  // Collapse/Expand Right TOC
  const tocToggle = document.getElementById('toc-toggle');
  const tocSidebar = document.getElementById('right-toc');

  tocToggle?.addEventListener('click', () => {
    tocSidebar?.classList.toggle('collapsed');
    const isCollapsed = tocSidebar?.classList.contains('collapsed');
    localStorage.setItem('dhanpedia-right-toc', isCollapsed ? 'collapsed' : 'expanded');
  });

  if (localStorage.getItem('dhanpedia-right-toc') === 'collapsed') {
    tocSidebar?.classList.add('collapsed');
  }
</script>

<style>
  .sidebar-right {
    width: var(--sidebar-right-width);
    flex-shrink: 0;
    height: calc(100vh - 70px);
    position: sticky;
    top: 70px;
    background-color: var(--bg-surface);
    border-left: 1px solid var(--border-light);
    display: flex;
    flex-direction: column;
    transition: width var(--transition-normal);
    z-index: 20;
    overflow: hidden;
  }

  .sidebar-right.collapsed {
    width: 48px;
  }

  .sidebar-right.collapsed .toc-title,
  .sidebar-right.collapsed .reading-progress-bar-container,
  .sidebar-right.collapsed .toc-nav,
  .sidebar-right.collapsed .toc-footer {
    display: none;
  }

  .sidebar-right.collapsed .toc-toggle-btn svg {
    transform: rotate(180deg);
  }

  .toc-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: var(--space-4);
    border-bottom: 1px solid var(--border-light);
  }

  .toc-title {
    font-size: 0.85rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--text-muted);
  }

  .toc-toggle-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 28px;
    height: 28px;
    border-radius: var(--radius-sm);
    background: transparent;
    border: 1px solid var(--border-light);
    color: var(--text-secondary);
    cursor: pointer;
  }

  .reading-progress-bar-container {
    width: 100%;
    height: 3px;
    background-color: var(--bg-subtle);
  }

  .reading-progress-bar {
    height: 100%;
    width: 0%;
    background-color: var(--accent-gold);
    transition: width 100ms ease;
  }

  .toc-nav {
    flex: 1;
    overflow-y: auto;
    padding: var(--space-4);
  }

  .toc-list {
    list-style: none;
    margin: 0;
  }

  .toc-item {
    margin-bottom: var(--space-2);
  }

  .toc-item.level-3 {
    margin-left: var(--space-3);
  }

  .toc-link {
    display: block;
    font-size: 0.82rem;
    color: var(--text-secondary);
    text-decoration: none;
    line-height: 1.4;
    padding: 0.15rem 0;
    border-left: 2px solid transparent;
    padding-left: var(--space-2);
    transition: all var(--transition-fast);
  }

  .toc-link:hover {
    color: var(--text-primary);
  }

  .toc-link.active {
    color: var(--accent-gold-dark);
    font-weight: 600;
    border-left-color: var(--accent-gold);
  }

  [data-theme="dark"] .toc-link.active {
    color: var(--accent-gold);
  }

  .toc-empty {
    font-size: 0.82rem;
    color: var(--text-muted);
  }

  .toc-footer {
    padding: var(--space-3) var(--space-4);
    border-top: 1px solid var(--border-light);
    background-color: var(--bg-surface-elevated);
  }

  .back-to-top-link {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--text-muted);
    text-decoration: none;
  }

  .back-to-top-link:hover {
    color: var(--accent-gold);
  }

  @media (max-width: 1280px) {
    .sidebar-right {
      display: none;
    }
  }
</style>
